# The frontend reads VITE_* values from the repository-root .env file.
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Optional: preserve Supabase Auth for an existing admin identity provider.
# SQLite-backed relational operations and local folder connections do not use it.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
