# =====================================================================
# Continuum backend: SQLite is the primary relational database.
# Relative database paths resolve from backend/; the default is
# repository-root continuum_local.db (ignored by Git).
# =====================================================================
PROJECT_NAME="Continuum Knowledge Continuity Platform"
ENVIRONMENT="development"
DEBUG=true
DATABASE_URL="sqlite+aiosqlite:///../continuum_local.db"
SYNC_DATABASE_URL="sqlite:///../continuum_local.db"

# Admin login uses the local database by default. Supabase Auth is optional
# for existing deployments; these values are not used for relational storage.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
ADMIN_REGISTRATION_MODE="open"
REGISTRATION_INVITE_CODE="set-a-local-invite-code"
JWT_SECRET="replace-with-a-long-random-local-secret"

# Local knowledge paths are resolved against the repository root and confined
# to its data/ directory. Leave unset to use <project-root>/data.
# PROJECT_ROOT="/absolute/path/to/continuum"
# LOCAL_DATA_ROOT="/absolute/path/to/continuum/data"

# Local AI and vector storage
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIR="./chroma_data"
# CHROMA_URL="http://localhost:8001"

# Background jobs and email
REDIS_URL="redis://localhost:6379/0"
EMAIL_PROVIDER="console"
SENDER_EMAIL="admin@continuum.internal"

# Optional public GitHub API rate-limit token. Drive and Notion use local folders.
# GITHUB_API_TOKEN=""
INITIAL_ADMIN_EMAIL="admin@continuum.io"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-local-password"
INITIAL_ADMIN_NAME="Company Administrator"
