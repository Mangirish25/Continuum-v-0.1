# ==============================================================================
# Continuum — Enterprise Knowledge Continuity Platform Configuration
# ==============================================================================

# Application & Environment
PROJECT_NAME="Continuum Knowledge Continuity Platform"
ENVIRONMENT="development"
DEBUG=true

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In your Supabase Project Settings -> Database -> Connection string:
# Direct Connection (Port 5432):
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require"
#
# Supabase Connection Pooler (Port 6543, Transaction mode - Recommended):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require"
#
# For offline local development / testing without active Supabase project:
DATABASE_URL="sqlite+aiosqlite:///continuum_local.db"
SYNC_DATABASE_URL="sqlite:///continuum_local.db"

# ------------------------------------------------------------------------------
# Supabase Auth Configuration
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings -> API:
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-ANON-KEY]"
# Optional: Service role key for administrative/background tasks (NEVER expose to frontend):
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
# Optional: JWT Secret (from Supabase Project Settings -> API -> JWT Settings) for local token verification:
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"

# ------------------------------------------------------------------------------
# Administrator Registration Policy
# ------------------------------------------------------------------------------
# "open" allows open administrator self-registration for development.
# "restricted" requires the REGISTRATION_INVITE_CODE to register an administrator account.
ADMIN_REGISTRATION_MODE="open"
REGISTRATION_INVITE_CODE="CONTINUUM-ADMIN-INVITE-2026"

# ------------------------------------------------------------------------------
# Internal Security & Encryption
# ------------------------------------------------------------------------------
JWT_SECRET="continuum-secret-key-change-in-production-32bytes-min!"
# 32-byte base64 Fernet key used to encrypt OAuth tokens stored in the database:
TOKEN_ENCRYPTION_KEY="c2VjcmV0LWtleS0zMi1ieXRlcy1mb3ItYWVzLWVuY3J5cHRpb24="

# ------------------------------------------------------------------------------
# Background Processing (Celery & Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Local AI, LLM, and Vector Storage (Local & Free)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIR="./chroma_data"

# ------------------------------------------------------------------------------
# External Knowledge Integrations (OAuth)
# ------------------------------------------------------------------------------
# Google Drive (Google Cloud Console OAuth 2.0 Client):
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/connections/google/callback"

# Notion Integration:
NOTION_CLIENT_ID="your-notion-client-id"
NOTION_CLIENT_SECRET="your-notion-client-secret"
NOTION_REDIRECT_URI="http://localhost:8000/api/v1/connections/notion/callback"

# Jira Cloud Integration:
JIRA_CLIENT_ID="your-jira-client-id"
JIRA_CLIENT_SECRET="your-jira-client-secret"
JIRA_REDIRECT_URI="http://localhost:8000/api/v1/connections/jira/callback"

# Public GitHub (Optional token for higher rate limits):
GITHUB_API_TOKEN=""

# ------------------------------------------------------------------------------
# Email Service
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="console"
SENDER_EMAIL="admin@continuum.internal"
